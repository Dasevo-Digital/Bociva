# Einstellungen des Bociva-Servers (/etc/bociva/bociva.env)
BOCIVA_HOST=0.0.0.0
BOCIVA_PORT=8770
BOCIVA_DATA_DIR=/var/lib/bociva/data
# Getrennt von den Daten sichern: ohne Schlüssel ist die Datenbank unlesbar.
BOCIVA_KEY_FILE=/var/lib/bociva/keys/bociva.key
BOCIVA_WEB_DIR=/opt/bociva/web
# Hinter einem Reverse Proxy (Nginx Proxy Manager): die Adresse aus
# X-Forwarded-For nehmen. Nur, wenn Port 8770 allein vom Proxy erreichbar ist
# (nftables.conf)!
BOCIVA_TRUST_PROXY=true
# Speicher pro Konto in MB und KI-Anfragen pro Tag für alle zusammen:
#BOCIVA_USER_QUOTA_MB=200
#BOCIVA_AI_DAILY_LIMIT=500
# KI-Analyse über einen Dienst mit Chat-Completions-Schnittstelle:
#BOCIVA_AI_BASE_URL=http://192.168.10.x:11434/v1
#BOCIVA_AI_MODEL=name-des-modells
#BOCIVA_AI_API_KEY=
# Kontakt in der Kennung gegenüber Open Food Facts (von dort erwünscht):
#BOCIVA_FOOD_CONTACT=
TZ=Europe/Berlin
